# ##############################################################################
# 鸿蒙 OpenHarmony / HarmonyOS 标准 .gitignore
# 适用于：DevEco Studio, ArkTS, hvigor, ohpm
# ##############################################################################

# 编译产物
build/
build-profile.json5.user
oh_modules/
node_modules/
.hvigor/
.gradle/
.hmscore/

# IDE 配置（DevEco / Android Studio）
.idea/
*.iml
*.iws
*.ipr
local.properties
.idea/
.DS_Store

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 日志
*.log
*.log.*
logs/
log/
temp/
tmp/

# 密钥 / 本地配置
key/
keys/
*.keystore
*.p12
*.jks
signing/
sign/
local.properties
.env
.env.local

# 运行缓存
*.hmr.json
.cache/
.temp/

# 测试产物
coverage/
*.test
*.spec

# 其他
*.apk
*.hap
*.bin
*.tmp
